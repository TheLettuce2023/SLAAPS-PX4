# SLAAPS airframe integration target, separate from retained stock/bench images.
CONFIG_MODULES_SLAAPS=y
CONFIG_MODULES_RESEARCH_STABILIZED_MANUAL=n
CONFIG_RESEARCH_STABILIZED_OUTPUT_HOOK=n
CONFIG_MODULES_RESEARCH_BENCH_CONTROL=n
# MAIN/AUX activation validates the shared profile on hp_default. The measured
# ARM call chain exceeds 2.6 KiB; reserve stack here without changing stock PX4.
CONFIG_WQ_HP_DEFAULT_STACKSIZE=4096
CONFIG_MODULES_FW_AUTOTUNE_ATTITUDE_CONTROL=n
CONFIG_MODULES_MC_AUTOTUNE_ATTITUDE_CONTROL=n
# QGC-based SLAAPS target does not use MSP video overlay; retain flash for its control/output owners.
CONFIG_DRIVERS_OSD_MSP_OSD=n
# Camera gimbal control is outside this airframe's requested control path.
CONFIG_MODULES_GIMBAL=n
# SLAAPS uses its own fixed-EDF controller; stock winged-VTOL transitions are not a supported mode.
CONFIG_MODULES_VTOL_ATT_CONTROL=n
# SLAAPS has no supported mission/RTL navigator or navigator geofence service.
# Common startup skips this module for VEHICLE_TYPE=slaaps; Commander and
# MAVLink remain present for the external-mode and commissioning workflows.
CONFIG_MODULES_NAVIGATOR=n
CONFIG_MODE_NAVIGATOR_VTOL_TAKEOFF=n
# rc.slaaps_apps exclusively owns this dedicated target's control/output path.
# Stock fixed-wing/multicopter controllers are neither started nor supported
# as fallback. Retain the allocator build for native QGC actuator metadata;
# rc.slaaps_apps does not start it as an output owner.
CONFIG_MODULES_FLIGHT_MODE_MANAGER=n
CONFIG_MODULES_FW_ATT_CONTROL=n
CONFIG_MODULES_FW_LATERAL_LONGITUDINAL_CONTROL=n
CONFIG_MODULES_FW_MODE_MANAGER=n
CONFIG_MODULES_FW_RATE_CONTROL=n
CONFIG_MODULES_MC_ATT_CONTROL=n
CONFIG_MODULES_MC_POS_CONTROL=n
CONFIG_MODULES_MC_HOVER_THRUST_ESTIMATOR=n
CONFIG_MODULES_MC_RATE_CONTROL=n
# Flash headroom: the companion link is signed MAVLink and mode selection must not require ROS 2,
# so the uXRCE-DDS bridge is not used.
CONFIG_MODULES_UXRCE_DDS_CLIENT=n
# No camera on this airframe; the starts are TRIG_MODE/CAM_CAP_FBACK-gated in rcS.
CONFIG_DRIVERS_CAMERA_CAPTURE=n
CONFIG_DRIVERS_CAMERA_TRIGGER=n
CONFIG_MODULES_CAMERA_FEEDBACK=n
# Precision landing depends on the navigator, which this target does not build.
CONFIG_MODULES_LANDING_TARGET_ESTIMATOR=n
# No rangefinder on this vehicle (confirmed by the project lead).
CONFIG_COMMON_DISTANCE_SENSOR=n
CONFIG_MAVLINK_DIALECT="slaaps"
