// Canonical scalar fields, QGC metadata and validation bounds. Zero physical values mean unconfigured.
// SLAAPS_FLOAT/INT(member, name, group, description, unit, min, max, default)
// feedback.imu_position and cutoff_hz bind existing EKF2_IMU_POS_* and
// IMU_ACCEL_CUTOFF parameters; native definitions are intentionally not duplicated here.
SLAAPS_INT(acceleration_control.enabled, SLA_ACC_CTL_EN, "SLAAPS Acceleration", "Enable configured acceleration and absolute-attitude calculation; no flight permission", "", 0, 1, 0)
SLAAPS_FLOAT(acceleration_control.acceleration_feedback_p[0], SLA_ACC_P_X, "SLAAPS Acceleration", "Body FRD X outer acceleration proportional correction gain", "", 0.0F, 1000.0F, 0.0F)
SLAAPS_FLOAT(acceleration_control.acceleration_feedback_p[1], SLA_ACC_P_Y, "SLAAPS Acceleration", "Body FRD Y outer acceleration proportional correction gain", "", 0.0F, 1000.0F, 0.0F)
SLAAPS_FLOAT(acceleration_control.acceleration_feedback_p[2], SLA_ACC_P_Z, "SLAAPS Acceleration", "Body FRD Z outer acceleration proportional correction gain", "", 0.0F, 1000.0F, 0.0F)
SLAAPS_FLOAT(acceleration_control.correction_limit[0], SLA_ACC_LIM_X, "SLAAPS Acceleration", "Maximum absolute body FRD X acceleration feedback correction", "m/s^2", 0.0F, 1000.0F, 0.0F)
SLAAPS_FLOAT(acceleration_control.correction_limit[1], SLA_ACC_LIM_Y, "SLAAPS Acceleration", "Maximum absolute body FRD Y acceleration feedback correction", "m/s^2", 0.0F, 1000.0F, 0.0F)
SLAAPS_FLOAT(acceleration_control.correction_limit[2], SLA_ACC_LIM_Z, "SLAAPS Acceleration", "Maximum absolute body FRD Z acceleration feedback correction", "m/s^2", 0.0F, 1000.0F, 0.0F)
SLAAPS_INT(feedback.enabled, SLA_FB_EN, "SLAAPS Feedback", "Enable configured CG acceleration feedback; no flight permission", "", 0, 1, 0)
SLAAPS_INT(feedback.maximum_age_us, SLA_FB_AGE, "SLAAPS Feedback", "Maximum original acceleration sample age; must exceed latency", "us", 0, 1000000, 0)
SLAAPS_INT(feedback.maximum_bias_age_us, SLA_FB_BIAS_AGE, "SLAAPS Feedback", "Maximum original selected accelerometer bias age", "us", 0, 1000000, 0)
SLAAPS_INT(feedback.latency_bound_us, SLA_FB_LAT_US, "SLAAPS Feedback", "Declared relative sensor and filter latency bound; not qualified automatically", "us", 0, 1000000, 0)
SLAAPS_INT(feedback.settling_us, SLA_FB_SETTLE_US, "SLAAPS Feedback", "Stable-source settling wait; at least declared latency", "us", 0, 60000000, 0)
SLAAPS_FLOAT(feedback.maximum_specific_force_m_s2, SLA_FB_F_MAX, "SLAAPS Feedback", "Maximum accepted specific-force magnitude; zero is unconfigured", "m/s^2", 0.0F, 1000.0F, 0.0F)
SLAAPS_FLOAT(feedback.maximum_acceleration_m_s2, SLA_FB_A_MAX, "SLAAPS Feedback", "Maximum accepted CG inertial acceleration magnitude", "m/s^2", 0.0F, 1000.0F, 0.0F)
SLAAPS_FLOAT(feedback.gravity_m_s2, SLA_FB_GRAV, "SLAAPS Feedback", "Declared gravity magnitude; no assumed Earth default", "m/s^2", 0.0F, 1000.0F, 0.0F)
SLAAPS_INT(data_schema_version, SLA_DATA_VER, "SLAAPS Vehicle", "SLAAPS profile schema version; only version 1 is supported", "", 1, 1, 1)
SLAAPS_INT(data_record_id, SLA_DATA_REC, "SLAAPS Vehicle", "Operator-declared external data record ID; zero is unassigned", "", 0, 2147483647, 0)
